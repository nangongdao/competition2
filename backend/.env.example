# AI 同声传译助手 — 环境配置模板
# 复制此文件为 .env 并填入实际值

# ---- 翻译引擎 ----
# Anthropic Claude API (推荐)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
NMT_ENGINE=claude
NMT_MODEL=claude-sonnet-4-20250514

# 或使用 OpenAI 兼容 API
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# NMT_ENGINE=openai
# NMT_MODEL=gpt-4o

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- 服务配置 ----
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ---- ASR 配置 ----
ASR_ENGINE=whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# ---- 上下文窗口 ----
CONTEXT_WINDOW_SIZE=10
SEGMENT_TTL_SECONDS=300

# ---- 修正引擎 ----
REVISION_ENABLED=true
REVISION_TRIGGER_SENTENCES=3
REVISION_MAX_WINDOW=8