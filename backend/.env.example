# AI Interpreter environment template.
# Copy this file to backend/.env.local and fill real values there.
# backend/.env.local is ignored by Git and must not be committed.

# ---- Translation engine ----
# Anthropic Claude API.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
NMT_ENGINE=claude
NMT_MODEL=claude-sonnet-4-20250514

# Or use an OpenAI-compatible API.
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# NMT_ENGINE=openai
# NMT_MODEL=gpt-4o

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
# RESP2 keeps local Redis 3.x compatible; newer Redis versions also support it.
REDIS_PROTOCOL=2
# Redis 键前缀，避免与同实例其他应用冲突。
REDIS_KEY_PREFIX=ai-interpreter

# ---- Service ----
# 默认仅监听本机回环。如需局域网访问，请先配置鉴权再改为 0.0.0.0。
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ---- CORS ----
# 逗号分隔的允许来源列表。桌面/本地场景默认只放行本机前端。
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- ASR ----
# Default remote ASR. This calls an OpenAI-compatible /audio/transcriptions
# endpoint. Official OpenAI Whisper API format:
#   ASR_OPENAI_MODEL=whisper-1
#   ASR_OPENAI_BASE_URL=https://api.openai.com/v1
# Do not include /audio/transcriptions in ASR_OPENAI_BASE_URL.
# Reuses OPENAI_API_KEY and OPENAI_BASE_URL unless the ASR-specific values below
# are set.
ASR_ENGINE=openai
ASR_OPENAI_MODEL=whisper-1
# ASR_OPENAI_API_KEY=your-openai-api-key-here
# ASR_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local Whisper ASR. This may download model files on first use.
# ASR_ENGINE=whisper
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# Higher-accuracy GPU machines can use:
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16

# ---- Context window ----
CONTEXT_WINDOW_SIZE=10
SEGMENT_TTL_SECONDS=300

# ---- Language configuration ----
# SOURCE_LANGUAGE supports en, ja, ko, es, fr, de, or auto.
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=zh-CN

# ---- Revision engine ----
REVISION_ENABLED=true
REVISION_TRIGGER_SENTENCES=3
REVISION_MAX_WINDOW=8

# ---- Diagnostics ----
DIAGNOSTICS_EMIT_INTERVAL_SECONDS=1.0
