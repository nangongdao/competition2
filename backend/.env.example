# AI Interpreter environment template.
# Copy this file to backend/.env.local and fill real values there.
# backend/.env.local is ignored by Git and must not be committed.

# ---- Translation engine ----
# Anthropic Claude API.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
NMT_ENGINE=claude
NMT_MODEL=claude-sonnet-4-20250514

# Or use an OpenAI-compatible API.
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# NMT_ENGINE=openai
# NMT_MODEL=gpt-4o

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
# RESP2 keeps local Redis 3.x compatible; newer Redis versions also support it.
REDIS_PROTOCOL=2
# Redis 键前缀，避免与同实例其他应用冲突。
REDIS_KEY_PREFIX=ai-interpreter

# ---- Service ----
# 默认仅监听本机回环。如需局域网访问，请先配置鉴权再改为 0.0.0.0。
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ---- CORS ----
# 逗号分隔的允许来源列表。桌面/本地场景默认只放行本机前端。
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- ASR ----
# Default remote ASR. This calls an OpenAI-compatible /audio/transcriptions
# endpoint. Official OpenAI Whisper API format:
#   ASR_OPENAI_MODEL=whisper-1
#   ASR_OPENAI_BASE_URL=https://api.openai.com/v1
# Do not include /audio/transcriptions in ASR_OPENAI_BASE_URL.
# Reuses OPENAI_API_KEY and OPENAI_BASE_URL unless the ASR-specific values below
# are set.
ASR_ENGINE=openai
ASR_OPENAI_MODEL=whisper-1
# ASR_OPENAI_API_KEY=your-openai-api-key-here
# ASR_OPENAI_BASE_URL=https://api.openai.com/v1

# 术语热词注入 ASR（阶段 2）：术语表 source 同时作为 ASR 热词提示，
# 降低技术术语/品牌名/缩写在识别阶段的误识别率。
# 关闭后仅保留 NMT 侧术语约束（不影响翻译链路）。
# ASR_HOTWORDS_ENABLED=true
# 单次请求热词上限 / 单热词最大长度。
# ASR_HOTWORDS_MAX_TERMS=30
# ASR_HOTWORDS_MAX_TERM_LENGTH=40

# ASR 文本后处理（阶段 2）：对 ASR 输出做轻量规范化
# （折叠连续空白、补全句尾标点、恢复句首大写），提升字幕观感与翻译质量。
# 关闭后保持 ASR 原文直通。
# ASR_TEXT_POSTPROCESS_ENABLED=true

# Optional local Whisper ASR. This may download model files on first use.
# ASR_ENGINE=whisper
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# Higher-accuracy GPU machines can use:
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16

# ---- Context window ----
CONTEXT_WINDOW_SIZE=10
SEGMENT_TTL_SECONDS=300

# ---- Language configuration ----
# SOURCE_LANGUAGE supports en, zh-CN, ja, ko, es, fr, de, or auto.
SOURCE_LANGUAGE=en
# TARGET_LANGUAGE supports zh-CN, en, ja, ko, es, fr, de.
TARGET_LANGUAGE=zh-CN

# ---- TTS (backend voice synthesis) ----
# engine: edge (free, no key) | openai (OpenAI-compatible API) | off
TTS_ENGINE=edge
# edge-tts voices: zh-CN-XiaoxiaoNeural (female), zh-CN-YunxiNeural (male), en-US-AriaNeural ...
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
# OpenAI TTS (requires TTS_OPENAI_API_KEY):
# TTS_ENGINE=openai
# TTS_OPENAI_MODEL=tts-1
# TTS_OPENAI_BASE_URL=https://api.openai.com/v1
# TTS_OPENAI_API_KEY=your-openai-api-key-here

# ---- Translation Memory (V5.3) ----
# 相似句直接复用已翻译结果，减少重复 API 调用。
TRANSLATION_MEMORY_ENABLED=true
# 命中相似度阈值（归一化后 0~1，越大越严格；默认 0.82）。
TRANSLATION_MEMORY_THRESHOLD=0.82

# ---- Translation style (Phase 3) ----
# 字幕翻译风格预设：concise（简洁，默认）| faithful（忠实）| lecture（讲义式总结）。
# 也可在控制面板实时切换（通过 WebSocket config 消息下发）。
TRANSLATION_STYLE=concise

# ---- Revision engine ----
REVISION_ENABLED=true
REVISION_TRIGGER_SENTENCES=3
REVISION_MAX_WINDOW=8

# ---- Translation memory (TM) ----
# 翻译记忆：相似/重复句直接复用，减少上游 LLM 调用。
# TM_ENABLED=true
# TM_MAX_ENTRIES_PER_PAIR=200
# TM_EXACT_THRESHOLD=0.96
# TM_FUZZY_THRESHOLD=0.72

# ---- Diagnostics ----
DIAGNOSTICS_EMIT_INTERVAL_SECONDS=1.0

# ---- TTS 语音合成（后端下发） ----
# 引擎：off（默认禁用）/ edge（edge-tts 免费，无需 key）/ openai（OpenAI 兼容）
# TTS_ENGINE=edge
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_RATE=+0%
# TTS_VOLUME=+0%
# TTS 合成结果磁盘缓存目录（跨会话复用，重启不丢；留空则仅用内存缓存）
# TTS_CACHE_DIR=config/tts-cache
# TTS_CACHE_MAX_FILES=2048
# 使用 OpenAI 兼容引擎时配置：
# TTS_ENGINE=openai
# TTS_OPENAI_MODEL=tts-1
# TTS_OPENAI_BASE_URL=https://api.openai.com/v1
# TTS_OPENAI_API_KEY=your-openai-key-here
# ---- Subscription (V5.5, local quota) ----
# 套餐：free (¥0/月, 每日 200 句) | pro (¥29/月, 每日 5000 句) |
#       team (¥99/月, 每日 20000 句) | enterprise (定制, 无限用量)
# 切换套餐通过 REST PUT /api/v1/subscription 或前端订阅面板；
# 这里只是默认值（首次启动免费版）。
SUBSCRIPTION_PLAN=free

# ---- Cost model (商用成本模型) ----
# 估算 NMT token 单价（美元/百万 token），用于成本展示与熔断建议。
# 以 OpenAI gpt-4o-mini 量级为参考：输入 $0.15/M，输出 $0.60/M。
# COST_NMT_INPUT_PER_M=0.15
# COST_NMT_OUTPUT_PER_M=0.60
# 每日成本软上限（美元），超过后在成本面板给出降级建议（不中断翻译）。
# COST_DAILY_LIMIT_USD=2.0
